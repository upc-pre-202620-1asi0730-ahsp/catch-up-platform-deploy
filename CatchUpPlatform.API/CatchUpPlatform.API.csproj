<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>false</InvariantGlobalization>
        <Version>1.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- Entity Framework Core related packages -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <!-- MySQL Entity Framework Core related packages -->
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
        <!-- Naming convention conversion related packages -->
        <PackageReference Include="Humanizer" Version="3.0.10" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.0" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="News\Infrastructure\Persistence\EFC\" />
    </ItemGroup>

</Project>
